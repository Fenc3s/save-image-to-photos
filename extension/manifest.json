{
  "manifest_version": 3,
  "name": "Save Image to Photos",
  "version": "0.2.3",
  "minimum_chrome_version": "128",
  "description": "Send an image to the macOS share sheet, then choose Add to Photos. No companion app required.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Save Image to Photos \u2014 Help"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "incognito": "not_allowed"
}
